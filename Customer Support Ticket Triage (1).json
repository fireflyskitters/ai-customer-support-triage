    {
      "parameters": {
        "jsCode": "const emails = [\n\n  {\n\n    subject: \"Entire team unable to access the platform\",\n\n    body: \"Our entire company has been unable to access your platform for an hour. All 50 employees are blocked from working.\"\n\n  },\n\n  {\n\n    subject: \"Question about my latest invoice\",\n\n    body: \"My October invoice is slightly higher than usual. There's no rush, but could you explain the additional charge?\"\n\n  },\n\n  {\n\n    subject: \"Duplicate payment charged\",\n\n    body: \"We were charged $2,500 twice. This is causing serious cash flow problems. Please help urgently.\"\n\n  },\n\n  {\n\n    subject: \"Update company information\",\n\n    body: \"We've changed our company name and billing address. Could you update our account? There's no deadline.\"\n\n  },\n\n  {\n\n    subject: \"Reports not exporting\",\n\n    body: \"I receive an error when exporting reports to PDF. I can still view them online, but I need downloads for weekly meetings.\"\n\n  },\n\n  {\n\n    subject: \"Salesforce integration\",\n\n    body: \"Does your software integrate with Salesforce? We'd also like information about enterprise pricing.\"\n\n  },\n\n  {\n\n    subject: \"Unauthorized administrator changes\",\n\n    body: \"Someone changed our administrator email without permission. We can no longer access admin settings and suspect a security breach.\"\n\n  },\n\n  {\n\n    subject: \"Cancel subscription\",\n\n    body: \"Please cancel our subscription at the end of the current billing period. There's no rush.\"\n\n  },\n\n  {\n\n    subject: \"Incorrect financial dashboard\",\n\n    body: \"Our dashboard is showing incorrect revenue figures. We have a board presentation in two hours and urgently need accurate data.\"\n\n  },\n\n  {\n\n    subject: \"Help with subscription\",\n\n    body: \"I'm having trouble with my subscription. Could someone contact me to discuss my options?\"\n\n  }\n\n];\n\nreturn emails.map((email, index) => ({\n\n  json: {\n\n    id: `TEST-${String(index + 1).padStart(3, '0')}`,\n\n    From: `Customer ${index + 1} <customer${index + 1}@example.com>`,\n\n    Subject: email.subject,\n\n    snippet: email.body,\n\n    internalDate: Date.now().toString()\n\n  }\n\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
